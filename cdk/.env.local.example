# GitHub configuration when using GitHub Apps
# (Optional) If not set, Personal Access Token (see README) is used instead
# Example: "12345678"
GITHUB_APP_ID=""
# Example: "87654321"
GITHUB_INSTALLATION_ID=""

# Restrict access to the Slack app for certain users (comma-separated)
# (Optional) If not set, all users in the workspace can access the app
# Example: "U0123456789,U0QWERTYUIO"
SLACK_ADMIN_USER_ID_LIST=""

# Invitation email is sent on deploy to this email.
# (Optional) If not set, you need to manually create users in Cognito console
# Example: "foo@example.com"
INITIAL_WEBAPP_USER_EMAIL=""

# AWS WAF config.
# (Optional) If not set, no IP/country restrictions are applied
# Example: "203.0.113.0/24,198.51.100.0/24"
ALLOWED_IPV4_CIDRS=""
# Example: "2001:db8::/32"
ALLOWED_IPV6_CIDRS=""
# Example: "JP,US"
ALLOWED_COUNTRY_CODES=""

# Additional IAM managed policies to allow access from agents.
# (Optional) If not set, only minimal policies are attached
# Example: "AmazonS3ReadOnlyAccess,AmazonDynamoDBReadOnlyAccess"
WORKER_ADDITIONAL_POLICIES=""

# LLM Provider: 'bedrock' (default) or 'anthropic'
# (Optional) If not set, defaults to 'bedrock'
# When set to 'anthropic', provide CLAUDE_CODE_OAUTH_TOKEN (preferred) or ANTHROPIC_API_KEY below
LLM_PROVIDER=""

# Claude Code OAuth token (Claude subscription, e.g. from `claude setup-token`)
# (Preferred when LLM_PROVIDER='anthropic'. Takes precedence over ANTHROPIC_API_KEY if both are set.)
# Any non-empty value enables SSM lookup. Store the actual token in '/remote-swe/anthropic/oauth-token' before deploying.
# Example: "sk-ant-oat01-..."
CLAUDE_CODE_OAUTH_TOKEN=""

# Anthropic API Key
# (Optional alternative to CLAUDE_CODE_OAUTH_TOKEN when LLM_PROVIDER='anthropic')
# Store the actual value in SSM parameter '/remote-swe/anthropic/api-key' before deploying.
# Example: "sk-ant-api03-..."
ANTHROPIC_API_KEY=""

# Bedrock Cross-Region Inference profile. Choose from: global, us, eu, apac, jp, au
# (Optional) If not set, defaults to 'us'
# NOTE: Models are filtered based on the specified region's CRI profile support.
# (e.g. to use Opus 4.5, you need to set "global")
BEDROCK_CRI_REGION_OVERRIDE=""

# Use existing VPC instead of creating a new one
# (Optional) If not set, a new VPC is created
# Example: "vpc-0123456789abcdef0"
VPC_ID=""

# EC2 instance type for worker instances
# (Optional) If not set, defaults to 't3.large'. Use smaller types (e.g. t3.medium) to reduce cost
# Example: "t3.medium"
WORKER_INSTANCE_TYPE="t3.medium"

# Use Spot instances for workers to reduce EC2 cost. Falls back to On-Demand if Spot is unavailable
# (Optional) If not set, defaults to false. Set to "true" to enable
# WORKER_USE_SPOT="true"

# When user ends a session, terminate the EC2 instance (reduces EBS cost; no wake-up for that session)
# (Optional) If not set, defaults to false. Set to "true" to enable
# WORKER_TERMINATE_ON_SESSION_END="true"

# Allow new sessions only from Slack (disable WebApp and API session creation)
# (Optional) If set to "true", sessions can only be started from Slack
# SLACK_ONLY_SESSION_CREATION="true"

# Stack name suffix
# (Optional) If not set, defaults to 'Sandbox'
# Set this to deploy multiple stacks in the same AWS account or to distinguish different environments
# Example: "Production"
TARGET_ENV=""
